(kicad_pcb
  (version 20260206)
  (generator "pcbnew")
  (generator_version "10.0")
  (general (thickness 1.6))
  (paper "A4")
  (layers
    (0 "F.Cu" signal)
    (2 "B.Cu" signal)
    (5 "F.SilkS" user "F.Silkscreen")
    (7 "B.SilkS" user "B.Silkscreen")
    (1 "F.Mask" user)
    (3 "B.Mask" user)
    (25 "Edge.Cuts" user)
    (31 "F.CrtYd" user "F.Courtyard")
    (29 "B.CrtYd" user "B.Courtyard")
    (35 "F.Fab" user)
    (33 "B.Fab" user)
  )
  (setup (pad_to_mask_clearance 0))

  (footprint "Copperline_Corpus_Pin_1x01"
    (layer "F.Cu")
    (uuid "00000000-0000-4000-8000-000000000001")
    (at 5 10)
    (property "Reference" "J1" (at 0 -2 0) (layer "F.SilkS"))
    (property "Value" "CORPUS_IN" (at 0 2 0) (layer "F.Fab"))
    (fp_rect
      (start -1.5 -1.5)
      (end 1.5 1.5)
      (stroke (width 0.05) (type solid))
      (fill no)
      (layer "F.CrtYd"))
    (pad "1" thru_hole circle
      (at 0 0)
      (size 2 2)
      (drill 1)
      (layers "*.Cu" "*.Mask")
      (net "SIGNAL")
      (uuid "00000000-0000-4000-8000-000000000011"))
  )

  (footprint "Copperline_Corpus_Pin_1x01"
    (layer "F.Cu")
    (uuid "00000000-0000-4000-8000-000000000002")
    (at 25 10)
    (property "Reference" "J2" (at 0 -2 0) (layer "F.SilkS"))
    (property "Value" "CORPUS_OUT" (at 0 2 0) (layer "F.Fab"))
    (fp_rect
      (start -1.5 -1.5)
      (end 1.5 1.5)
      (stroke (width 0.05) (type solid))
      (fill no)
      (layer "F.CrtYd"))
    (pad "1" thru_hole circle
      (at 0 0)
      (size 2 2)
      (drill 1)
      (layers "*.Cu" "*.Mask")
      (net "SIGNAL")
      (uuid "00000000-0000-4000-8000-000000000012"))
  )

  (gr_rect
    (start 0 0)
    (end 30 20)
    (radius 2)
    (stroke (width 0.05) (type solid))
    (fill no)
    (layer "Edge.Cuts")
    (uuid "00000000-0000-4000-8000-000000000021"))
)
