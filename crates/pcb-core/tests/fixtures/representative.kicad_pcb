(kicad_pcb (version 20240108) (generator pcbnew)
  (general (thickness 1.6))
  (title_block (title "Raised Trace Demo"))
  (net 1 "GND")
  (net 2 "SIG")
  (net 3 "AUX")
  (gr_rect (start 10 5) (end 50 30) (stroke (width 0.05) (type default)) (fill none) (layer "Edge.Cuts"))
  (segment (start 15 10) (end 25 10) (width 0.5) (layer "F.Cu") (net 1))
  (segment (start 20 10) (end 40 20) (width 0.8) (layer "B.Cu") (net 2))
  (via (at 25 10) (size 1.8) (drill 0.9) (layers "F.Cu" "B.Cu") (net 2))
  (footprint "Demo:Header" (layer "F.Cu")
    (at 20 10 90)
    (pad "1" thru_hole circle (at 0 0) (size 2.4 2.4) (drill 1) (layers "*.Cu" "*.Mask") (net 2 "SIG"))
    (pad "2" thru_hole oval (at 2 0 15) (size 2.8 1.8) (drill 1) (layers "*.Cu" "*.Mask") (net 2 "SIG"))
    (pad "3" smd rect (at 4 0) (size 2 1.4) (layers "F.Cu" "F.Paste" "F.Mask") (net 3 "AUX")))
  (zone (net 1) (net_name GND) (layer "F.Cu") (hatch edge 0.5))
)
