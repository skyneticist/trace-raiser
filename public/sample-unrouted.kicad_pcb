(kicad_pcb (version 20240108) (generator pcbnew)
  (general (thickness 1.6))
  (paper "A4")
  (title_block (title "Copperline AutoLayout demo"))
  (layers
    (0 "F.Cu" signal)
    (31 "B.Cu" signal)
    (36 "B.SilkS" user "b.silkscreen")
    (37 "F.SilkS" user "f.silkscreen")
    (44 "Edge.Cuts" user)
    (46 "B.CrtYd" user "b.courtyard")
    (47 "F.CrtYd" user "f.courtyard")
    (48 "F.Fab" user)
  )
  (setup (pad_to_mask_clearance 0))

  (net 0 "")
  (net 1 "SIGNAL")

  (footprint "Copperline_AutoLayout_Pin_1x01"
    (layer "F.Cu")
    (uuid "10000000-0000-4000-8000-000000000001")
    (at 5 10)
    (property "Reference" "J1" (at 0 -2 0) (layer "F.SilkS"))
    (property "Value" "AUTO_IN" (at 0 2 0) (layer "F.Fab"))
    (fp_rect
      (start -1.5 -1.5)
      (end 1.5 1.5)
      (stroke (width 0.05) (type solid))
      (fill none)
      (layer "F.CrtYd"))
    (pad "1" thru_hole circle
      (at 0 0)
      (size 2 2)
      (drill 1)
      (layers "*.Cu" "*.Mask")
      (net 1 "SIGNAL")
      (uuid "10000000-0000-4000-8000-000000000011"))
  )

  (footprint "Copperline_AutoLayout_Pin_1x01"
    (layer "F.Cu")
    (uuid "10000000-0000-4000-8000-000000000002")
    (at 25 10)
    (property "Reference" "J2" (at 0 -2 0) (layer "F.SilkS"))
    (property "Value" "AUTO_OUT" (at 0 2 0) (layer "F.Fab"))
    (fp_rect
      (start -1.5 -1.5)
      (end 1.5 1.5)
      (stroke (width 0.05) (type solid))
      (fill none)
      (layer "F.CrtYd"))
    (pad "1" thru_hole circle
      (at 0 0)
      (size 2 2)
      (drill 1)
      (layers "*.Cu" "*.Mask")
      (net 1 "SIGNAL")
      (uuid "10000000-0000-4000-8000-000000000012"))
  )

  (gr_rect
    (start 0 0)
    (end 30 20)
    (stroke (width 0.05) (type solid))
    (fill none)
    (layer "Edge.Cuts")
    (uuid "10000000-0000-4000-8000-000000000021"))
)
