(kicad_pcb (version 20240108) (generator pcbnew)
  (general (thickness 1.6))
  (paper "A4")
  (title_block (title "Copperline through-hole sensor interface"))
  (layers
    (0 "F.Cu" signal)
    (31 "B.Cu" signal)
    (36 "B.SilkS" user "b.silkscreen")
    (37 "F.SilkS" user "f.silkscreen")
    (44 "Edge.Cuts" user)
    (48 "F.Fab" user)
  )
  (setup (pad_to_mask_clearance 0))

  (net 0 "")
  (net 1 "SENSOR_VCC")
  (net 2 "SENSOR_DATA")
  (net 3 "SENSOR_CLOCK")
  (net 4 "SENSOR_GND")

  (footprint "Copperline_SensorHeader_1x04_P9mm_Vertical"
    (layer "F.Cu")
    (at 18 20)
    (property "Reference" "J1" (at 0 -4 0) (layer "F.SilkS"))
    (property "Value" "SENSOR" (at 0 31 0) (layer "F.Fab"))
    (fp_rect
      (start -2 -2)
      (end 2 29)
      (stroke (width 0.05) (type default))
      (fill none)
      (layer "F.CrtYd"))
    (pad "1" thru_hole rect (at 0 0) (size 3.6 3.6) (drill 1.2) (layers "*.Cu" "*.Mask") (net 1 "SENSOR_VCC"))
    (pad "2" thru_hole circle (at 0 9) (size 3.6 3.6) (drill 1.2) (layers "*.Cu" "*.Mask") (net 2 "SENSOR_DATA"))
    (pad "3" thru_hole circle (at 0 18) (size 3.6 3.6) (drill 1.2) (layers "*.Cu" "*.Mask") (net 3 "SENSOR_CLOCK"))
    (pad "4" thru_hole circle (at 0 27) (size 3.6 3.6) (drill 1.2) (layers "*.Cu" "*.Mask") (net 4 "SENSOR_GND"))
  )

  (footprint "Copperline_SensorHeader_1x04_P9mm_Vertical"
    (layer "F.Cu")
    (at 66 20)
    (property "Reference" "J2" (at 0 -4 0) (layer "F.SilkS"))
    (property "Value" "CONTROLLER" (at 0 31 0) (layer "F.Fab"))
    (fp_rect
      (start -2 -2)
      (end 2 29)
      (stroke (width 0.05) (type default))
      (fill none)
      (layer "F.CrtYd"))
    (pad "1" thru_hole rect (at 0 0) (size 3.6 3.6) (drill 1.2) (layers "*.Cu" "*.Mask") (net 1 "SENSOR_VCC"))
    (pad "2" thru_hole circle (at 0 9) (size 3.6 3.6) (drill 1.2) (layers "*.Cu" "*.Mask") (net 2 "SENSOR_DATA"))
    (pad "3" thru_hole circle (at 0 18) (size 3.6 3.6) (drill 1.2) (layers "*.Cu" "*.Mask") (net 3 "SENSOR_CLOCK"))
    (pad "4" thru_hole circle (at 0 27) (size 3.6 3.6) (drill 1.2) (layers "*.Cu" "*.Mask") (net 4 "SENSOR_GND"))
  )

  (segment (start 18 20) (end 66 20) (width 2.8) (layer "B.Cu") (net 1))
  (segment (start 18 29) (end 66 29) (width 2.8) (layer "B.Cu") (net 2))
  (segment (start 18 38) (end 66 38) (width 2.8) (layer "B.Cu") (net 3))
  (segment (start 18 47) (end 66 47) (width 2.8) (layer "B.Cu") (net 4))

  (gr_rect (start 10 14) (end 74 53) (stroke (width 0.25) (type default)) (fill none) (layer "Edge.Cuts"))
)
